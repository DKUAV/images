{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DKUAV image build manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "description", "dockerfile", "context", "platforms", "base", "build_args", "inputs", "smoke"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "description": {"type": "string", "minLength": 1},
    "dockerfile": {"type": "string", "minLength": 1},
    "context": {"const": "."},
    "platforms": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["linux/amd64", "linux/arm64"]}
    },
    "base": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["image", "digest"],
          "properties": {
            "image": {"type": "string", "minLength": 1},
            "digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["dependency"],
          "properties": {"dependency": {"type": "string", "minLength": 1}}
        }
      ]
    },
    "build_args": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Z][A-Z0-9_]*$", "not": {"enum": ["BASE_IMAGE", "BASE_TAG"]}},
      "additionalProperties": {"type": ["string", "number", "boolean"]}
    },
    "inputs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "smoke": {
      "type": "object", "additionalProperties": false,
      "required": ["script", "inputs", "policy"],
      "properties": {
        "script": {"type": "string", "minLength": 1},
        "inputs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "policy": {"enum": ["advisory", "required"]}
      }
    }
  }
}
